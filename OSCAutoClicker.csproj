<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OSCAutoClicker</RootNamespace>
    <AssemblyName>OSCAutoClicker</AssemblyName>
    <Version>1.0.1</Version>
    <Authors>aeongdesu</Authors>
    <PackageLicenseUrl>https://github.com/aeongdesu/OSCAutoClicker/blob/main/LICENSE</PackageLicenseUrl>
    <RepositoryUrl>https://github.com/aeongdesu/OSCAutoClicker</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="src\lang\*.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include=".github\workflows\build.yml" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\screenshot.png" />
  </ItemGroup>

</Project>
